# Copia este archivo a ".env" (o ".env.local") y rellena los valores.
# NUNCA commitees un ".env" real con URLs internas.

# URL del Web App de Apps Script desplegado (termina en /exec).
# Si se deja vacío, la app funciona en "modo local" (datos solo en memoria).
VITE_APPS_SCRIPT_URL=

# ID de la hoja de cálculo de Google Sheets que actúa como base de datos.
# El frontend no suele necesitarlo (habla vía la URL del Web App); se documenta
# porque es la pieza que conecta backend <-> datos.
VITE_SPREADSHEET_ID=1HKsAo3kDc_3fpvg8MeCj_vPtwEkm-T6_CjIBc1bFNPY
